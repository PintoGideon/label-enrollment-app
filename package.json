{
  "name": "label-enrollment-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "dev": "pnpm --filter @label-enrollment/workflow run dev",
    "build": "pnpm -r run build",
    "db:migrate": "pnpm --filter @label-enrollment/workflow run db:migrate",
    "db:generate": "pnpm --filter @label-enrollment/workflow run db:generate",
    "db:check": "pnpm --filter @label-enrollment/workflow run db:check",
    "fmt": "pnpm -r run fmt",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "check": "pnpm run db:check && pnpm run lint && pnpm run test"
  }
}
